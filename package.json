{
  "name": "sf-release-conflict-checker",
  "displayName": "SF Release Conflict Checker",
  "description": "Identify common Salesforce metadata between releases or user stories and view Git diffs",
  "version": "1.0.0",
  "publisher": "naveengit9",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sf-release-conflict-checker.open",
        "title": "SF: Release Conflict Checker"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  }
}
